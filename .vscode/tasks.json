{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build QuanLyDiemSV",
      "type": "shell",
      "command": "make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "command": "mingw32-make"
      },
      "linux": {
        "command": "make"
      }
    }
  ]
}

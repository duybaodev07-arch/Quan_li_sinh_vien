{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build QuanLyDiemSV",
      "type": "shell",
      "command": "mingw32-make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run QuanLyDiemSV",
      "type": "shell",
      "command": "mingw32-make",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
